#!/bin/bash
# 冬瓜HAOS 应用生命周期入口
# - start：拉起「IP 寻踪」转发器 + 虚拟机开机（应用启用 = 虚拟机跟着启动）
# - stop ：发 ACPI 优雅关机后立即返回，收尾交给后台守望（watch-shutdown）
#          —— 停用不能阻塞等待：实测阻塞期间平台状态机会把随后的「启动」判成
#          already started 直接跳过 main，虚拟机再也起不来（iStoreOS 2026-09-13）
# - 虚拟机也可随时在「虚拟机」应用独立操作；autostart 仍由安装向导选项决定
UNIT="dongguaha-web"
DOM="virsh -c qemu:///system"
VM="haos"
STOP_WATCH="/tmp/dongguaha-vm-stop.watch"
# 用户主动「停用」的标记：入口页据此决定是显示「已关机 + 启动按钮」还是自动补开
STOP_MARK="/tmp/dongguaha-user-stopped"
# 开机请求登记（应用启用 / 入口页一键开机 / 守望补开都会写它）：
# 守望进程据此判断「期间有人要开机」，放弃强制断电并在关机落定后补开
START_REQ="/tmp/haos-vm-start.req"
CALLS="/tmp/dongguaha-main-calls.log"

dgh_domstate() { $DOM domstate "$VM" 2>/dev/null; }

dgh_is_off() { case "$(dgh_domstate)" in *"shut off"*) return 0 ;; *) return 1 ;; esac; }

# 登记一次开机请求。先删再建：文件可能是别人（别的 uid）留下的，那样即使 root
# 也截不动它，mtime 停在旧值 → 守望会误判「没人请求开机」，把刚点亮的虚拟机
# 再强制断电（18.2.1 真机实测踩过一次）。
dgh_note_start() {
    rm -f "${START_REQ}" 2>/dev/null
    : > "${START_REQ}" 2>/dev/null || true
}

# 开机请求是否晚于守望启动时刻 $1
dgh_start_requested() {
    [ -f "${START_REQ}" ] || return 1
    [ "$(stat -c %Y "${START_REQ}" 2>/dev/null || echo 0)" -ge "${1:-0}" ]
}

# 关机落定后若期间有开机请求，就把虚拟机补开（并撤销停用标记）
dgh_honor_start() {
    if dgh_start_requested "${1:-0}"; then
        rm -f "${STOP_MARK}"
        $DOM start "$VM" >/dev/null 2>&1 && echo "守望：检测到开机请求，虚拟机已补开"
        return 0
    fi
    return 1
}

# 虚拟机 qemu 进程是否比时刻 $1 更新（说明期间被重新开过机）
dgh_vm_younger_than() {
    local pid t0
    pid="$(pgrep -f "guest=${VM}( |$)" | head -1)"
    [ -n "${pid}" ] || return 1
    t0="${1:-0}"
    [ "$(ps -o lstart= -p "${pid}" 2>/dev/null | xargs -I{} date -d "{}" +%s 2>/dev/null || echo 0)" -ge "${t0}" ]
}

dgh_watch_alive() {
    [ -f "${STOP_WATCH}" ] && kill -0 "$(cat "${STOP_WATCH}" 2>/dev/null)" 2>/dev/null
}

dgh_vm_start() {
    dgh_note_start
    $DOM dominfo "$VM" >/dev/null 2>&1 || { echo "虚拟机尚未定义（安装未完成时属正常）"; return 0; }
    # 上一次优雅关机还没落定时先等它停稳，否则 virsh start 会撞「正在关机」
    if dgh_watch_alive; then
        echo "上一次优雅关机仍在收尾，等待落定…"
        i=0
        while [ "$i" -lt 12 ] && dgh_watch_alive; do sleep 5; i=$((i+1)); done
    fi
    case "$(dgh_domstate)" in
        running)  echo "虚拟机已在运行"; return 0 ;;
        paused)   $DOM resume "$VM" >/dev/null 2>&1 && echo "虚拟机已从挂起恢复"; return 0 ;;
    esac
    $DOM start "$VM" >/dev/null 2>&1 && echo "虚拟机正在启动"
    # libvirt 偶尔静默失败：确认落到 running，否则重试一次
    i=0
    while [ "$i" -lt 5 ]; do
        [ "$(dgh_domstate)" = "running" ] && return 0
        sleep 2; i=$((i+1))
    done
    $DOM start "$VM" >/dev/null 2>&1 && echo "虚拟机起机已重试"
    return 0
}

dgh_vm_stop() {
    local st
    st="$(dgh_domstate)"
    if [ "$st" = "paused" ]; then
        : > "${STOP_MARK}"
        $DOM destroy "$VM" >/dev/null 2>&1 && echo "虚拟机已强制断电（原为挂起态）"
        return 0
    fi
    if [ "$st" != "running" ]; then
        # 虚拟机本来就没在跑：绝不伪造「用户主动停用」标记。否则平台在停用/回滚
        # 清理期间多调一次 stop，会把标记重新写出来，入口页便谎报「已关机」，
        # 用户会被自己没做过的操作困住（iStoreOS 2026-09-14 00:22 同类实测）。
        echo "虚拟机未运行（当前 ${st:-未知}），无需关机"
        return 0
    fi
    : > "${STOP_MARK}"
    # 关机优先走 QEMU guest agent：HAOS 自带 qemu-guest-agent，实测秒级~十几秒
    # 落定；纯 ACPI 要 35~53 秒（用户反馈的「关机要 1 分钟」就是这个）。
    # 之前试过两路同时下发，结果两条请求在 guest 里互相排队，反而更慢，
    # 所以这里只走一条，agent 不可用时才退回 ACPI。
    if $DOM shutdown "$VM" --mode agent >/dev/null 2>&1; then
        echo "已通过 guest-agent 下发关机"
    else
        echo "guest-agent 不可用，改用 ACPI"
        $DOM shutdown "$VM" >/dev/null 2>&1
    fi
    if dgh_watch_alive; then
        echo "优雅关机指令已在执行中（守望进程 ${STOP_WATCH}）"
        return 0
    fi
    setsid nohup bash "$0" watch-shutdown >/dev/null 2>&1 &
    echo "优雅关机指令已发出（后台等待，最多 60 秒转强制断电）"
    return 0
}

# 调用留痕：平台的「启用/停用」究竟回调了哪些动作，事后一眼可查（/tmp，重启自清）
echo "$(date -Iseconds) arg=${1:-} ppid=$(ps -o args= -p "$PPID" 2>/dev/null | cut -c1-90)" \
    >> "${CALLS}" 2>/dev/null || true

case $1 in
    start)
        rm -f "${STOP_MARK}"
        systemctl start "$UNIT" 2>/dev/null && echo "IP 寻踪已启动 (入口 36123 / 后台代理 36124)"
        dgh_vm_start
        # 重试钩子：后台安装未完成/已失败且虚拟机尚未定义时，按原参数重新拉起
        # worker。判据要足够保守——state 文件 15 分钟内没动静、或明确 failed，
        # 才认为那一轮真的死了，别把正在进行的任务重复拉起。
        ST="/tmp/haos-install.state"
        LOCK="/tmp/haos-install.lock"
        if ! $DOM dominfo "$VM" >/dev/null 2>&1 \
           && [ -f /tmp/haos-install.env ] && ! grep -q '^ready' "$ST" 2>/dev/null \
           && { [ ! -f "$ST" ] || grep -q '^failed' "$ST" 2>/dev/null \
                || [ $(( $(date +%s) - $(stat -c %Y "$ST" 2>/dev/null || echo 0) )) -ge 900 ]; }; then
            W=""
            for d in /var/apps/com.dongguaha.vm/target/bin /var/apps/com.dongguaha.vm/bin \
                     /vol1/@appcenter/com.dongguaha.vm/bin; do
                [ -f "${d}/haos-install-worker.sh" ] && W="${d}/haos-install-worker.sh" && break
            done
            if [ -n "${W}" ] && ! { [ -f "${LOCK}" ] && kill -0 "$(cat "${LOCK}" 2>/dev/null)" 2>/dev/null; }; then
                rm -f "${LOCK}"
                if command -v systemd-run >/dev/null 2>&1; then
                    systemctl stop dongguaha-install.service 2>/dev/null || true
                    systemctl reset-failed dongguaha-install.service 2>/dev/null || true
                    systemd-run --unit=dongguaha-install --remain-after-exit \
                        /bin/bash "${W}" /tmp/haos-install.env >/dev/null 2>&1 || true
                else
                    setsid nohup /bin/bash "${W}" /tmp/haos-install.env >/tmp/haos-install.out 2>&1 &
                    echo $! > "${LOCK}"
                fi
                echo "后台安装已重新拉起（进度: cat ${ST}）"
            fi
        fi
        exit 0
        ;;
    watch-shutdown)
        # 后台守望：等优雅关机落定，超时转强制断电；自己记 pid 供 start 判断。
        # 期间若有人请求开机（应用启用、入口页一键开机），绝不再强制断电，而是
        # 等 ACPI 落定后把虚拟机补开——旧写法 60 秒后无条件 destroy，会把刚重新
        # 开机的虚拟机再强制断电（iStoreOS 平台事件 00:11:19 已开机 →
        # 00:12:14 STATUS_SHUTOFF_VM 就是这么来的）。
        echo $$ > "${STOP_WATCH}"
        T0=$(date +%s)
        i=0
        while [ "$i" -lt 12 ]; do
            sleep 5
            i=$((i+1))
            if dgh_is_off; then
                dgh_honor_start "$T0"
                rm -f "${STOP_WATCH}"
                exit 0
            fi
            if [ "$i" -eq 3 ]; then
                # 15 秒仍未落定：再补一次 agent 关机（可能那时 agent 才起来，
                # 或第一次下发被 guest 忽略了）
                $DOM shutdown "$VM" --mode agent >/dev/null 2>&1 \
                    && echo "守望：已补发 guest-agent 关机" \
                    || echo "守望：guest-agent 仍不可用"
            fi
            if [ "$i" -eq 6 ]; then
                # 30 秒：agent 也没打动，补一次 ACPI，让守望剩下的 30 秒还能等它
                $DOM shutdown "$VM" >/dev/null 2>&1
                echo "守望：已补发 ACPI 关机"
            fi
        done
        if dgh_start_requested "$T0"; then
            echo "守望：期间收到开机请求，取消强制断电"
        elif dgh_vm_younger_than "$T0"; then
            # 独立于标记文件的第二道判据：qemu 进程比守望本身还年轻，说明期间
            # 有人重新开了机（入口页/worker/虚拟机应用），绝不能把它断电。
            echo "守望：虚拟机进程比本次关机请求更新，取消强制断电"
        else
            $DOM destroy "$VM" >/dev/null 2>/dev/null
        fi
        rm -f "${STOP_WATCH}"
        exit 0
        ;;
    stop)
        dgh_vm_stop
        echo "IP 寻踪入口保持在线（可在入口页一键开机）"
        exit 0
        ;;
    status)
        # 恒报健康（iStoreOS 2026-09-14 定论，别再改回去）：
        # · 实测平台的「启用」压根不会回调本脚本（只有「停用」会调 stop），
        #   所以「报未运行好让平台回调开机」是幻想；
        # · 反过来，停用期间报 3 会被平台判成 APP_CRASH，之后连补开机都不做，
        #   应用卡在异常态甚至被自动清理。
        # 关机后的重新开机交给入口页：虚拟机关着时打开入口会自动补开（见 finder）。
        exit 0
        ;;
    *) exit 1 ;;
esac
