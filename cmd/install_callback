#!/bin/bash
# 冬瓜HAOS FPK - 安装回调（秒回模式）
#
# 平台对安装回调有约 190 秒看门狗：超时判 APP_INSTALL_FAILED_INSTALL_CALLBACK_EXCEPTION，
# install-fpk 还会段错误退出。冬瓜四个 HAOS 镜像都是 900MB 级（实测 886~904 MB），
# 在回调里同步下载完全押在带宽上，所以这里只做参数校验、写状态、拉起后台 worker
# 后立即返回，下载/校验/入池/定义虚拟机全部异步进行。
#   进度: cat /tmp/haos-install.state     日志: tail -f /tmp/haos-install.log
set -e

echo "[$(date)] 冬瓜HAOS install_callback（秒回模式）收到安装请求"

# ---- 参数快速校验（让用户在向导阶段就拿到明确错误，而不是等后台失败）----
HAOS_MEM="${wizard_haos_mem:-2048}"
case "${HAOS_MEM}" in ''|*[!0-9]*) HAOS_MEM=0 ;; esac
MEM_TOTAL_MB=$(awk '/MemTotal/{print int($2/1024); exit}' /proc/meminfo)
MEM_MAX_MB=$((MEM_TOTAL_MB - 1536)); [ "${MEM_MAX_MB}" -gt 65536 ] && MEM_MAX_MB=65536
if [ "${HAOS_MEM}" -lt 1024 ] || [ "${HAOS_MEM}" -gt "${MEM_MAX_MB}" ]; then
    echo "错误: 内存大小 ${HAOS_MEM}MB 超出允许范围。本机物理内存 ${MEM_TOTAL_MB}MB，需为飞牛系统保留至少 1536MB，请输入 1024~${MEM_MAX_MB} 之间的整数（MB）"
    exit 1
fi
case "${wizard_haos_version:-18.2}" in
    18.2|18.1|18.0|17.3.1) : ;;
    *) echo "⚠️ 版本 ${wizard_haos_version:-} 不在支持列表（18.2/18.1/18.0/17.3.1），将回退到 18.2" ;;
esac

# ---- 环境变量快照（后台 worker 继承不到回调环境，显式落盘传递）----
ENVF="/tmp/haos-install.env"
: > "${ENVF}"
for v in wizard_haos_version wizard_haos_cpu wizard_haos_mem wizard_haos_disk \
         wizard_haos_autostart TRIM_TEMP_LOGFILE TRIM_DATA_SHARE_PATHS \
         TRIM_PKGVAR TRIM_PKGDIR TRIM_APPDEST; do
    val="${!v}"
    [ -n "${val}" ] && printf '%s=%q\n' "$v" "${val}" >> "${ENVF}"
done

# ---- 防重复拉起 ----
LOCK_FILE="/tmp/haos-install.lock"
if [ -f "${LOCK_FILE}" ] && kill -0 "$(cat "${LOCK_FILE}" 2>/dev/null)" 2>/dev/null; then
    echo ">>> 安装任务已在运行中（pid $(cat "${LOCK_FILE}")），跳过重复拉起"
    exit 0
fi

STATE_FILE="/tmp/haos-install.state"
echo "queued" > "${STATE_FILE}"

# ---- 脱离会话拉起后台 worker ----
# 必须用 systemd-run 瞬时单元把 worker 移出平台会话进程树：实测 nohup/setsid
# 的孙进程会在安装任务收尾时被平台清扫击杀（iStoreOS 1.0.2 首轮复现：worker
# 在 extracting 中途无声消失，无 OOM、无 ERR trap 触发）。
cat > /tmp/haos-install-launch.sh <<'LAUNCH'
#!/bin/bash
    # payload 文件部署可能稍晚于回调，轮询等 worker 落地（最多 3 分钟）
    W=""
    for i in $(seq 1 36); do
        for d in /var/apps/com.dongguaha.vm/target/bin /var/apps/com.dongguaha.vm/bin \
                 /vol1/@appcenter/com.dongguaha.vm/bin; do
            [ -f "${d}/haos-install-worker.sh" ] && { W="${d}/haos-install-worker.sh"; break 2; }
        done
        sleep 5
    done
    if [ -z "${W}" ]; then
        echo "failed: 未找到后台安装脚本(worker)，请重装" > /tmp/haos-install.state
        exit 1
    fi
    exec /bin/bash "${W}" /tmp/haos-install.env
LAUNCH
chmod +x /tmp/haos-install-launch.sh
if command -v systemd-run >/dev/null 2>&1; then
    # --remain-after-exit 的瞬时单元结束后单元名会残留，同名再 run 必撞车失败，
    # 所以先 stop + reset-failed 清干净
    systemctl stop dongguaha-install.service 2>/dev/null || true
    systemctl reset-failed dongguaha-install.service 2>/dev/null || true
    systemd-run --unit=dongguaha-install --remain-after-exit \
        /bin/bash /tmp/haos-install-launch.sh >/tmp/haos-install.out 2>&1 \
        || echo "failed: 无法拉起后台安装(systemd-run)" > "${STATE_FILE}"
else
    nohup setsid /bin/bash /tmp/haos-install-launch.sh >/tmp/haos-install.out 2>&1 &
    echo $! > "${LOCK_FILE}"
fi

echo "✅ 安装任务已提交，正在后台进行（下载官方镜像 886~904 MB + 校验 + 创建虚拟机）"
echo "   进度: cat ${STATE_FILE}      日志: tail -f /tmp/haos-install.log"
echo "   完成后点桌面「冬瓜HAOS」或「Home Assistant」图标即可进入；虚拟机关着时入口页可一键开机"
exit 0
